# Copy to .env. Do not commit .env.

# Live model calls. Either name is accepted.
# OPEN_AI_KEY=sk-...
# OPENAI_API_KEY=sk-...
# OPEN_AI_ORG=org-...

# Model and prompt axes. Defaults match the original agent.
# OPENAI_MODEL=gpt-4
# OPENAI_TEMPERATURE=0.1
# OPENAI_TIMEOUT_SECS=120
# PROMPT_VERSION=v1
# TOOL_SCHEMA_VERSION=v1

# Paths. Defaults are the in-repo Actix template.
# WEB_SERVER_PROJECT_PATH=web_template
# CODE_TEMPLATE_PATH=web_template/src/code_template.rs
# EXEC_MAIN_PATH=web_template/src/main.rs
# API_SCHEMA_PATH=schemas/api_schema.json

# Skip the "is this code safe to run?" prompt. Replay sets this itself.
# AUTO_CONFIRM=1

# Treat external URL checks as HTTP 200. Replay sets this itself.
# SKIP_NETWORK_CHECKS=1

# Verification timeouts.
# BUILD is bounded by cargo. Smoke waits for GET /health.
# SMOKE_TIMEOUT_SECS=15
# ENDPOINT_TIMEOUT_SECS=5

# Tracing. Spans follow RUST_LOG (default info).
# RUST_LOG=info
# Write a JSON trace without a collector:
# OTEL_TRACES_FILE=docs/sample_trace.json
# Export OTLP/HTTP to Jaeger or a collector (see deploy/jaeger-compose.yaml):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Python judge. Unset uses the offline rubric model.
# EVAL_LIVE=1
# OPENAI_API_KEY is also read by LangChain when EVAL_LIVE=1.

# Keep generated replay projects for inspection.
# KEEP_REPLAY_DIRS=1
